#include <iostream>

using namespace std;
int fPrint(int *arr,int idx,int n){



        if(idx==n-1) return arr[idx];

        return max(arr[idx],fPrint(arr,idx+1,n));

    
}
int main(){
    int arr[]={1,3,7,4,2,1};

    int n=sizeof(arr)/sizeof(arr[0]);

    cout<<fPrint(arr,0,n);

    return 0;
}